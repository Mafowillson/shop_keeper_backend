MONGO_URI=db://localhost:27017
DB_NAME=shopkeeper_database
PORT=8080
JWT_SECRET=my-super-secret-access-key-change-in-production
JWT_REFRESH_SECRET=my-super-secret-refresh-key-change-in-production
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=168h
FIREBASE_CREDENTIALS_FILE=firebase_credentials.json

# SMTP email — leave SMTP_HOST empty to use console logging in development.
# For Gmail: enable 2-Step Verification → create an App Password (16 chars).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM=ShopKeeper <noreply@shopkeeper.cm>
GROQ_API_KEY=groq_api_key_here